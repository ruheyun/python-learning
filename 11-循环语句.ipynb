   "source": [
    "循环语句是用来重复执行某一段代码的语句。只要满足条件，代码就会一遍一遍地执行，直到条件不满足为止。"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7dd54265",
   "metadata": {},
   "source": [
    "例子：输出 1到100 这100个数的和(for/while)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "7b810a1a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "5050"
      ]
     },
     "execution_count": 1,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "result = 0\n",
    "for i in range(1, 101):\n",
    "    result += i\n",
    "\n",
    "result"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b8848ca7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "5050"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "result = 0\n",
    "i = 1\n",
    "while i <= 100:\n",
    "    result += i\n",
    "    i += 1  # 如果忽略了这行代码，程序将陷入无限循环，注意！\n",
    "\n",
    "result"
   ]
  },
  {
